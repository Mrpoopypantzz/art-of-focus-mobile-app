# append the two helpers before the final closing brace of MuseumRepository
awk '
  /^    private fun PaintingEntity.toDomainOrNull/ && !done {
    print "    /** localId alongside the record — the sync layer needs it to mark rows pushed. */"
    print "    suspend fun allWithLocalIds(): List<Pair<Long, CompletedPainting>> ="
    print "        dao.getAll().mapNotNull { entity -> entity.toDomainOrNull()?.let { entity.localId to it } }"
    print ""
    print "    /** Sync bookkeeping only — never touches the earned painting content (I12). */"
    print "    suspend fun markSynced(localId: Long, syncedAt: Long) = dao.markSynced(localId, syncedAt)"
    print ""
    done=1
  }
  { print }
' data/repository/MuseumRepository.kt > /tmp/mr.kt && mv /tmp/mr.kt data/repository/MuseumRepository.kt
grep -n "allWithLocalIds\|markSynced" data/repository/MuseumRepository.kt
echo "--- PaintingEntity localId field? ---"; grep -n "localId" data/local/PaintingEntity.kt
